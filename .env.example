# =========================================================================
# CUBBOOK — Vercel 伺服器端環境變數範本（切勿加上 VITE_ 前綴）
# 前端 bundle 只會拿到空值；所有密碼與網址均在伺服器端讀取。
# =========================================================================

# 1. 領袖模式密碼（必填以啟用當面掃描核簽的「領袖只讀模式」）
#    比較於 /api/leader，使用 crypto.timingSafeEqual，絕不送入前端。
#    Vercel → Project → Settings → Environment Variables
#      Name = LEADER_CODE   Value = 你的領袖密碼（6 位或以上）  Scope = Production
#    未設定則自動隱藏領袖模式入口（純成員版）。本機 `npm run dev` 未設定時預設 1234 方便測試。
LEADER_CODE=

# 2. 幼童軍旅團進度系統 CUBSBADGE 網址（零金鑰：BOOK 不儲存任何 Google Sheet 網址或 API key）
#    支援 CUBSBADGE_ORIGIN 或 CUBBADGE_ORIGIN；未設定時預設 https://cubsbadge.vercel.app。
#    GET /api/troops 由此變數於伺服器端組出旅團清單；POST /api/proxy 轉發登入／讀取／待核實提交。
#    BADGE → BOOK：只錄入領袖在 CUBSBADGE 已核實（confirmed）的 progress / otherBadges，
#    pendingRequests 永不錄入；BOOK → BADGE：一律寫成 status: 'pending'，由領袖 CONFIRM。
CUBBADGE_ORIGIN=https://cubsbadge.vercel.app

# 3. 個別旅團覆寫（選填）。每個旅團一組，格式 TROOP_<id>_<KEY>
#    <id> 可為 CUBSBADGE 旅團編號或自訂英數字（底線分隔），<KEY> 為 NAME / EN / BACKEND / APIKEY。
#    例：
#      TROOP_1234_NAME=第 1234 旅
#      TROOP_1234_EN=1234th Group
#      TROOP_1234_BACKEND=https://script.google.com/macros/s/AKfy…/exec
#      TROOP_1234_APIKEY=
#    若只使用 CUBSBADGE_ORIGIN / CUBBADGE_ORIGIN，BOOK 會由 GET <origin>/api/troops 自動取得已登記旅團清單。
TROOP_EXAMPLE_NAME=
TROOP_EXAMPLE_EN=
TROOP_EXAMPLE_BACKEND=
TROOP_EXAMPLE_APIKEY=

# 4. 本機測試允許 127.0.0.1 目標（僅非 Vercel 環境且值為 1 時生效）
CUBBOOK_PROXY_TEST=0
